# Google Cloud service account credentials (ADC)
# In Docker: this file is bind-mounted read-only into the container.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json

# Google Cloud project (required)
VIDPIPE_GOOGLE_CLOUD__PROJECT_ID=your-gcp-project-id

# Region (optional, defaults to us-central1)
# VIDPIPE_GOOGLE_CLOUD__LOCATION=us-central1

# Storage — Database URL
# SQLite (default, zero-dependency local dev):
# VIDPIPE_STORAGE__DATABASE_URL=sqlite+aiosqlite:///vidpipe.db
#
# PostgreSQL (via asyncpg — for Supabase / shared environments):
# VIDPIPE_STORAGE__DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/vidpipe_master
#
# PostgreSQL via Supavisor pooler (port 6543, tenant in username):
# VIDPIPE_STORAGE__DATABASE_URL=postgresql+asyncpg://postgres.your-tenant-id:password@localhost:6543/vidpipe_master

# Storage — Temp directory (optional override)
# VIDPIPE_STORAGE__TMP_DIR=/app/tmp

# Server port (local dev without Docker)
# VIDPIPE_SERVER__PORT=8000

# Pipeline (optional overrides)
# VIDPIPE_PIPELINE__MAX_SCENES=10
# VIDPIPE_PIPELINE__RETRY_MAX_ATTEMPTS=3

# ---- Docker-specific ----

# Host ports exposed by Docker Compose
# VIDPIPE_PORT=8000
# VIDPIPE_FRONTEND_PORT=80

# ComfyUI (optional, for WAN model routing)
# COMFY_UI_HOST=http://host.docker.internal:8188
# COMFY_UI_KEY=

# ---- Supabase provisioning (used by scripts/provision_databases.py) ----
# SUPABASE_HOST=localhost
# SUPABASE_PORT=5432
# SUPABASE_USER=postgres
# SUPABASE_PASSWORD=your-password
# SUPABASE_TENANT=your-tenant-id
