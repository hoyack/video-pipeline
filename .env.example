# Vidpipe Environment Configuration
#
# Copy to .env and fill in values.
# GCP credentials, model selection, ComfyUI, Ollama, and ElevenLabs
# are configured via the Settings UI (stored in database).

# ---- Docker Compose ----

# Host ports exposed by Docker Compose
VIDPIPE_PORT=8100
VIDPIPE_FRONTEND_PORT=80

# ---- Database ----

# PostgreSQL via Supavisor pooler (tenant ID in username, port 6543):
VIDPIPE_STORAGE__DATABASE_URL=postgresql+asyncpg://postgres.your-tenant-id:your-password@supabase-pooler:6543/postgres

# Direct PostgreSQL (no pooler):
# VIDPIPE_STORAGE__DATABASE_URL=postgresql+asyncpg://postgres:your-password@supabase-db:5432/postgres

# SQLite (local dev without Docker):
# VIDPIPE_STORAGE__DATABASE_URL=sqlite+aiosqlite:///vidpipe.db

# ---- Supabase Storage (S3) ----

# Service role key for Supabase Storage bucket access
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-jwt

# ---- Google Cloud ----

# Fallback project ID (used if not configured in Settings UI)
VIDPIPE_GOOGLE_CLOUD__PROJECT_ID=configure-in-settings

# Path to service account JSON (bind-mounted into container as /app/credentials.json)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json

# ---- Local Dev (without Docker) ----

# Server port
# VIDPIPE_SERVER__PORT=8000
