# Vidpipe Environment Configuration
#
# Copy to .env and fill in values.
# Model selection, Ollama, and ElevenLabs are configured via the
# Settings UI (stored in database). ComfyUI and GCP can be configured
# in the Settings UI too — the env vars below act as fallbacks.

# ---- Docker Compose ----

# Host ports exposed by Docker Compose
VIDPIPE_PORT=8100
VIDPIPE_FRONTEND_PORT=80

# ---- Database ----

# PostgreSQL via Supavisor pooler (tenant ID in username, port 6543):
VIDPIPE_STORAGE__DATABASE_URL=postgresql+asyncpg://postgres.your-tenant-id:your-password@supabase-pooler:6543/postgres

# Direct PostgreSQL (no pooler):
# VIDPIPE_STORAGE__DATABASE_URL=postgresql+asyncpg://postgres:your-password@supabase-db:5432/postgres

# SQLite (local dev without Docker):
# VIDPIPE_STORAGE__DATABASE_URL=sqlite+aiosqlite:///vidpipe.db

# ---- Supabase Storage (S3) ----

# Service role key for Supabase Storage bucket access
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-jwt
VIDPIPE_STORAGE__S3_SERVICE_KEY=${SUPABASE_SERVICE_ROLE_KEY}

# Set only when running the backend outside Docker against Supabase
# (docker-compose.yml sets these for the container automatically):
# VIDPIPE_STORAGE__STORAGE_BACKEND=s3
# VIDPIPE_STORAGE__S3_ENDPOINT=http://localhost:8000/storage/v1
# VIDPIPE_STORAGE__S3_BUCKET=vidpipe-master

# ---- Google Cloud ----

# Fallback project ID and location (used if not configured in Settings UI)
VIDPIPE_GOOGLE_CLOUD__PROJECT_ID=your-gcp-project-id
VIDPIPE_GOOGLE_CLOUD__LOCATION=us-central1

# Path to service account JSON (bind-mounted into container as /app/credentials.json)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json

# ---- ComfyUI (optional — needed for WAN video models) ----

# Fallback host and API key (used if not configured in Settings UI)
# COMFY_UI_HOST=https://cloud.comfy.org
# COMFY_UI_KEY=comfyui-your-api-key

# ---- Local Dev (without Docker) ----

# Backend server port (Docker maps via VIDPIPE_PORT instead)
# VIDPIPE_SERVER__PORT=8100
